# Copy to .env and fill in. config.Load() reports EVERY bad key at once, so a
# bad file fails in the first 50ms with a complete list rather than one key at
# a time. No secret has a default.

# ── core ─────────────────────────────────────────────────────────────────────
APP_ENV=dev                     # dev | staging | prod
HTTP_ADDR=:8080
BASE_URL=http://localhost:8080
LOG_LEVEL=debug                 # debug | info | warn | error
LOG_FORMAT=text                 # text locally, json in production
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# ── postgres ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://braelaspin:devpassword@localhost:5433/braelaspin?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
MIGRATE_ON_BOOT=true            # dev convenience; refused when APP_ENV=prod

# ── redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0
REDIS_POOL_SIZE=20

# ── auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_local_dev_secret_at_least_32_bytes_long
JWT_ISSUER=braelaspin
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
ARGON2_TIME=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=2

# ── game economics (basis points; 10000 = 100%) ──────────────────────────────
# RTP_BP is asserted against the wheel table at startup: if they disagree the
# process refuses to start rather than quietly shipping different odds.
RTP_BP=9000                     # 90.00% return to player -> 10% house edge
RAKE_BP=500                     # 5% retained
REFERRAL_BP=200                 # 2% to the referrer (0 when unreferred)
MIN_STAKE_CENTS=500             # KES 5
MAX_STAKE_CENTS=5000000         # KES 50,000
DEMO_GRANT_CENTS=500000         # KES 5,000 free on signup
DEMO_TOPUP_COOLDOWN=24h

# ── withdrawals ──────────────────────────────────────────────────────────────
WITHDRAW_FEE_CENTS=3000         # KES 30, covers the Safaricom B2C charge
MIN_WITHDRAW_CENTS=10000        # KES 100
MAX_WITHDRAW_CENTS=7000000      # KES 70,000 (Daraja per-transaction limit)
AUTO_APPROVE_CEILING_CENTS=0    # 0 = every withdrawal is reviewed by a human

# ── m-pesa: shared ───────────────────────────────────────────────────────────
MPESA_ENV=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# 32 random bytes in the callback path. Generate with: openssl rand -hex 32
# NEVER commit the real value.
MPESA_CALLBACK_SECRET=CHANGE_ME_random_hex_32_bytes
MPESA_CALLBACK_ALLOWED_CIDRS=196.201.214.0/24,196.201.213.0/24,196.201.212.0/24
# Ship false for a week, confirm the observed source IPs in the logs, then
# enforce. Required to be true when APP_ENV=prod.
MPESA_CALLBACK_IP_ENFORCE=false
# Deposits above this are confirmed by STK query rather than credited straight
# from the callback. The pull path cannot be forged.
MPESA_VERIFY_THRESHOLD_CENTS=500000
MPESA_DIAL_SHORTCODE=*334#
MPESA_MANUAL_TILL=

# ── m-pesa: c2b / STK push (deposits) ────────────────────────────────────────
MPESA_C2B_CONSUMER_KEY=
MPESA_C2B_CONSUMER_SECRET=
MPESA_C2B_SHORTCODE=
MPESA_C2B_PASSKEY=
MPESA_C2B_TRANSACTION_TYPE=CustomerPayBillOnline

# ── m-pesa: b2c (withdrawals) ────────────────────────────────────────────────
MPESA_B2C_CONSUMER_KEY=
MPESA_B2C_CONSUMER_SECRET=
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_INITIATOR_PASSWORD=
# Sandbox and production certificates differ. The SecurityCredential is
# computed from this at startup, so rotating the cert is a file swap + restart.
MPESA_B2C_CERT_PATH=./deploy/mpesa_sandbox.cer
MPESA_B2C_COMMAND_ID=BusinessPayment

# ── workers ──────────────────────────────────────────────────────────────────
WORKER_ENABLED=true
